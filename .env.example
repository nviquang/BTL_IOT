# Chép file này thành .env (cùng thư mục với config.yaml) rồi điền giá trị thật.
# KHÔNG commit .env. Biến môi trường thật sẽ thắng giá trị trong file này.

# Token bot Telegram (lấy từ @BotFather)
TELEGRAM_TOKEN=

# API key của Gemini
GEMINI_API_KEY=

# Các chat được phép điều khiển, cách nhau bằng dấu phẩy, ví dụ: 123456789, -1001234567890
ALLOWED_CHAT_IDS=

# Mật khẩu user MQTT (user đặt trong config.yaml, mục mqtt)
MQTT_PASSWORD=
