# Chạy aiot-weather.service mỗi 20 giây, để chế độ tức thời (weather.sustain_windows: 0)
# phản ứng ngay. AccuracySec=1s vì mặc định 1 phút. Persistent=false: Pi tắt thì không chạy bù
# (cảnh báo nắng/mưa cũ không còn ý nghĩa).
# Cài: xem aiot-weather.service. Kiểm tra: systemctl list-timers aiot-weather.timer
[Unit]
Description=Run AIoT sunny/rain alert every 20 seconds

[Timer]
OnCalendar=*:*:0/20
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
