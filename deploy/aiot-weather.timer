# Chạy aiot-weather.service mỗi 5 phút, ở phút 1, 6, 11, ... (sau khi collector ghi xong
# cửa sổ 5 phút vừa kết thúc). Persistent=false: Pi tắt lúc tới giờ thì không chạy bù
# (cảnh báo nắng/mưa cũ không còn ý nghĩa).
# Cài: xem aiot-weather.service. Kiểm tra: systemctl list-timers aiot-weather.timer
[Unit]
Description=Run AIoT sunny/rain alert every 5 minutes

[Timer]
OnCalendar=*:01/5
Persistent=false

[Install]
WantedBy=timers.target
